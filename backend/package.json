{
  "name": "estulanches-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API do EstuLanches (Fastify + Prisma + PostgreSQL)",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "prisma:migrate": "prisma migrate deploy",
    "seed": "node dist/prisma/seed.js",
    "seed:dev": "tsx prisma/seed.ts",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.8",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/static": "^10.1.12",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "prisma": "^6.19.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.12",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
