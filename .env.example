# =============================================================================
# Modelo de configuração do EstuLanches.
# Copie para ".env" e TROQUE todos os valores "troque-isto...".
# O arquivo .env NUNCA vai para o Git (está no .gitignore e no .dockerignore).
# =============================================================================

NODE_ENV=production
# Porta publicada no host (http://localhost:3000)
APP_PORT=3000

# Banco PostgreSQL (lidos pelo container "db")
POSTGRES_DB=estulanches
POSTGRES_USER=estulanches
POSTGRES_PASSWORD=troque-isto-por-uma-senha-forte
# Mesma senha de cima; "db" é o nome do serviço na rede interna do compose
DATABASE_URL=postgresql://estulanches:troque-isto-por-uma-senha-forte@db:5432/estulanches

# Autenticação — mínimo de 32 caracteres (a app recusa subir com menos)
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-isto-por-um-segredo-aleatorio-com-32-ou-mais-caracteres
JWT_EXPIRES_IN=8h

# Origem permitida no CORS
CORS_ORIGIN=http://localhost:3000
# Tentativas de login por minuto por IP (freio contra força bruta)
RATE_LIMIT_LOGIN=5

# Seed: cria usuários de demonstração, categorias e produtos (idempotente)
SEED=true
SEED_ADMIN_PASSWORD=troque-isto-senha-cantina
SEED_ALUNO_PASSWORD=troque-isto-senha-aluno
